# AI Maintenance Safety & Quality Monitor — backend configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Core ---
DEBUG=false

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/amsq

# --- Auth ---
# Use a random string of at least 32 bytes (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# --- Demo data ---
# Seed demo workers/jobs/SOPs/alerts on startup (idempotent).
SEED_DEMO_DATA=true

# --- AI mode ---
# demo        -> clearly-labelled simulated detections (no model needed)
# production  -> load real YOLO weights from models/yolo/
AI_MODE=demo
YOLO_MODEL_PATH=models/yolo/ppe_best.pt

# --- Cloud object storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=amsq-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Upload limits ---
MAX_UPLOAD_MB=10
